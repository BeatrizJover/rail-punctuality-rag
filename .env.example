# ── Application ──────────────────────────────────────────────
RAIL_RAG_ENVIRONMENT=development
RAIL_RAG_LOG_LEVEL=INFO

# ── PostgreSQL (see docker-compose.yml) ─────────────────────
RAIL_RAG_DB_HOST=localhost
RAIL_RAG_DB_PORT=5432
RAIL_RAG_DB_NAME=rail_rag
RAIL_RAG_DB_USER=rail_rag
RAIL_RAG_DB_PASSWORD=change-me

# ── Gemini API Key ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here